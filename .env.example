# PrimeCoat mobile — PUBLIC configuration only. Copy to .env (git-ignored).
# These values are bundled into the app. Never put the service-role key,
# database password, Mailgun key or Google client secret here.

# Same Supabase project as the web app (Dashboard → Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the PrimeCoat web app. Used for product images and POST /api/orders.
# Production: https://primecoatt.vercel.app
# Local web dev from an Android emulator: http://10.0.2.2:3000
# Local web dev from a phone on the same Wi-Fi: http://<your-computer-LAN-IP>:3000
EXPO_PUBLIC_SITE_URL=https://primecoatt.vercel.app
